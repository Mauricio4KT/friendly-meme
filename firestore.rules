rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /productos/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /appointmentRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
          'nombre', 'telefono', 'fecha', 'servicio', 'mensaje', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'nombre', 'telefono', 'fecha', 'servicio', 'mensaje', 'createdAt'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() <= 30
        && request.resource.data.fecha is string
        && request.resource.data.servicio in ['Maquillaje', 'Skincare', 'Perfumería']
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
